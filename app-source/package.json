{
  "name": "otukenai-corporate-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run audit:i18n && npm run build:client && npm run build:ssr && npm run prerender && npm run audit:public",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir ssr-dist",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "audit:i18n": "node scripts/audit-translations.mjs",
    "audit:public": "node scripts/audit-public-disclosure.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.3"
  }
}
